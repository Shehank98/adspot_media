rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper: check if the signed-in user is an admin
    // Primary: email match (reliable — no Firestore document dependency)
    // Fallback: Firestore role check (for future multi-admin support)
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'adspot77@gmail.com' ||
        request.auth.token.email == 'shehan.k98@gmail.com'
      );
    }

    // Ad artwork uploads (customers upload during booking)
    // Path: ad-artworks/{year}/{month}/{day}/{quotationNumber}/{filename}
    match /ad-artworks/{year}/{month}/{day}/{quotationNumber}/{filename} {
      // Any authenticated user can upload their own artwork
      allow create: if request.auth != null
                    && request.resource.size < 20 * 1024 * 1024  // 20 MB max
                    && request.resource.contentType.matches('image/.*|application/pdf');

      // Anyone can read (needed for thumbnail previews in admin panel)
      allow read: if request.auth != null;

      // Only admins can delete (for the auto-cleanup function)
      allow delete: if isAdmin();

      // Admins can update metadata
      allow update: if isAdmin();
    }

    // Newspaper logos (uploaded via admin panel)
    match /newspaper-logos/{filename} {
      allow read:   if true;           // Public — shown on booking page
      allow write:  if isAdmin();
      allow delete: if isAdmin();
    }

    // Payment slips (uploaded via admin Send to Publication)
    match /payment-slips/{filename} {
      allow read, write, delete: if isAdmin();
    }

    // Invoice PDFs (generated on booking + payment confirmation)
    match /invoices/{filename} {
      allow read: if true;                         // Customer downloads from emailed link
      allow create: if request.auth != null        // Booking flow (signed-in or anonymous with anon auth)
                    && request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType == 'application/pdf';
      allow delete: if isAdmin();
    }

    // Catch-all: deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
